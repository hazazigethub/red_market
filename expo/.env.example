# Same Supabase project as Red Market
NEXT_PUBLIC_SUPABASE_URL=https://ycuzwfsaxnfbdskerjfw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Session cookie domain. Leave empty unless a Red Market website shares the session (AUTH_MODE=redmarket).
NEXT_PUBLIC_COOKIE_DOMAIN=

# Red Market links
NEXT_PUBLIC_REDMARKET_URL=https://www.redmarket.pro
NEXT_PUBLIC_REDMARKET_LOGIN_PATH=/login
# Fallback only, when a product has no product_url. {id} is replaced.
NEXT_PUBLIC_PRODUCT_URL_TEMPLATE=https://redmarket.pro/products/{id}

# Public site URL (used for share links)
NEXT_PUBLIC_SITE_URL=https://expo.redmarket.pro

# Sign-in: "local" = login page on this site with the same Red Market accounts (email + password)
#          "redmarket" = redirect to Red Market's web login (needs a Red Market website sharing the cookie)
NEXT_PUBLIC_AUTH_MODE=local
